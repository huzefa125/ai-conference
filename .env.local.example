# Copy to .env.local and fill in. Without a project ID the site uses its built-in content.
# Content is read at build time: rebuild and redeploy to publish changes.

# From sanity.io/manage -> your project. Not secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Same values again for the Studio. It runs on Sanity (npm run studio / studio:deploy),
# and the Sanity CLI only reads variables that start with SANITY_STUDIO_.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
